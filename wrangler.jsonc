{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurantplus",
  "main": "src/entry.ts",
  "compatibility_date": "2026-06-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurantplus_db",
      "database_id": "59a72c3a-4c5e-4010-86d4-b0cb55f7b91b",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
